    "@livekit/agents-plugin-google": "1.10.1",
    "@livekit/rtc-node": "1.2.2",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "ai": "7.0.177",
    "dotenv": "^18.0.10",
    "livekit-client": "2.24.1",
    "livekit-server-sdk": "2.20.1",
    "lucide-react": "^1.73.0",
