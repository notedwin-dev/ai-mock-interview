# Copy to .env for local development:  cp .env.example .env

# --- Database (Prisma 7 + PostgreSQL, IR 2.4.4) ---
# Matches the docker-compose.yml defaults. Start it with:  docker compose up -d db
DATABASE_URL="postgresql://aimis:aimis@localhost:5432/aimis?schema=public"

# Shadow database used by `prisma migrate dev` to replay migrations. It must
# point at a disposable database, never the real one. With docker compose the
# `aimis_shadow` database is created automatically on first volume init
# (deploy/initdb). With `pnpm db:local` (Prisma Postgres dev), copy the
# SHADOW_DATABASE_URL printed by the dev server instead.
SHADOW_DATABASE_URL="postgresql://aimis:aimis@localhost:5432/aimis_shadow?schema=public"

# Dedicated integration-test database for *.db.test.ts suites (TESTING.md).
# Leave unset to keep `pnpm test` hermetic. With docker compose, create a
# separate `aimis_test` database; with Prisma Postgres dev run a second named
# server (pnpm prisma dev --name aimis-test) and copy its DATABASE_URL here.
# TEST_DATABASE_URL="postgresql://aimis:aimis@localhost:5432/aimis_test?schema=public"

# Consumed by docker compose only; the values above are already the defaults.
POSTGRES_USER=aimis
POSTGRES_PASSWORD=aimis
POSTGRES_DB=aimis

# --- Auth (Auth.js v5, credentials) ---
# Required. Generate with:  openssl rand -base64 32
# (Windows without openssl: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
AUTH_SECRET=""

# Set to "true" in production when the app is served behind a reverse proxy
# (the docker-compose nginx). `next dev` trusts localhost by default.
# AUTH_TRUST_HOST="true"

# --- AI services — deferred, provider not yet selected (IR 2.4.5) ---
# Question generation + answer evaluation (pick one provider)
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""
# GOOGLE_GENERATIVE_AI_API_KEY=""
# Whisper Large V3 — speech-to-text for spoken answers
# WHISPER_API_KEY=""
# ElevenLabs Multilingual v2 — text-to-speech for spoken questions
# ELEVENLABS_API_KEY=""
# FISH_AUDIO_API_KEY=""

# --- NVIDIA NIM (free hosted tier for LLM testing, 2026-11-19) ---
# Optional. Create a free key at https://build.nvidia.com/settings/api-keys.
# Keys have the form nvapi-<random string>. Never commit a real key; .env is gitignored.
# Hosted OpenAI-compatible base URL: https://integrate.api.nvidia.com/v1
# NVIDIA_API_KEY="nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# --- LiveKit WebRTC room (free Build plan / self-hosted, no billing required) ---
# Create a free project at https://cloud.livekit.io (Build plan: $0/mo, no card).
# These values are SERVER-SIDE ONLY: never expose the API secret to the browser.
# LIVEKIT_URL="wss://your-project.livekit.cloud"
# LIVEKIT_API_KEY="APIxxxxxxxxxxxx"
# LIVEKIT_API_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Optional: Google key used by the LiveKit Gemini Live agent (reuses the free key above).
# GOOGLE_GENERATIVE_AI_API_KEY is documented earlier in this file.